# ReviewLens Environment Configuration
# Copy this file to .env.local and populate your API key(s)
# NEVER commit your actual .env or .env.local file to version control!

# Primary AI Provider: Google Gemini API (Recommended, generous free tier)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Groq API Key (alternative high-speed free tier provider)
# Get a key at: https://console.groq.com/keys
GROQ_API_KEY=

# Preferred model name (e.g., gemini-1.5-flash, gemini-2.0-flash, or llama-3.3-70b-versatile for Groq)
AI_MODEL=gemini-1.5-flash

# Review batch size (default: 5 reviews per LLM request)
BATCH_SIZE=5

# Set to true to run deterministic offline mock analysis for testing without calling external APIs
MOCK_AI=false
